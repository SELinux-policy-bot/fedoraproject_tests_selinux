summary: SELinux interferes with tlshd and related programs
description: |+
    SELinux interferes with tlshd and related programs.

contact: Milos Malik <mmalik@redhat.com>
component:
  - selinux-policy
require:
  - library(selinux-policy/common)
recommend:
  - audit
  - libselinux
  - libselinux-utils
  - policycoreutils
  - selinux-policy
  - selinux-policy-targeted
  - setools-console
  - ktls-utils
  - /usr/sbin/service
environment:
    AVC_ERROR: +no_avc_check
duration: 10m
enabled: true
tag:
  - NoRHEL4
  - NoRHEL5
  - NoRHEL6
  - NoRHEL7
  - NoRHEL8
  - failinfedora
  - NoRHIVOS
link:
  - verifies: https://issues.redhat.com/browse/RHEL-29439
  - verifies: https://issues.redhat.com/browse/RHEL-42672
  - verifies: https://issues.redhat.com/browse/RHEL-74424
adjust+:
  - enabled: false
    when: distro == rhel-4, rhel-5, rhel-6, rhel-7, rhel-8, centos-stream-8
    because: the ktls-utils package is not available there
extra-summary: /CoreOS/selinux-policy/Regression/tlshd-and-similar
extra-task: /CoreOS/selinux-policy/Regression/tlshd-and-similar
extra-nitrate: TC#0617913
id: 63121e2f-20f3-4ded-80fe-ab98fecd79af
