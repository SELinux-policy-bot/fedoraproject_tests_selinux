summary: SELinux interferes with the systemd-modules-load service and related programs
description: |+
    SELinux interferes with the systemd-modules-load service and related programs.

contact: Milos Malik <mmalik@redhat.com>
component:
  - selinux-policy
require:
  - library(selinux-policy/common)
recommend:
  - audit
  - initscripts
  - libselinux
  - libselinux-utils
  - policycoreutils
  - rdma-core
  - selinux-policy
  - selinux-policy-targeted
  - setools-console
  - openssh-clients
  - systemd-udev
environment:
    AVC_ERROR: +no_avc_check
duration: 10m
enabled: true
tag:
  - NoRHEL4
  - NoRHEL5
  - NoRHEL6
  - NoRHEL7
  - f33friendly
  - targeted
  - failinfedora
  - NoRHIVOS
link:
