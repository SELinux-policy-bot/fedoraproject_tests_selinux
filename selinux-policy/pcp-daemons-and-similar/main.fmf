summary: the services were running as initrc_t, now they are confined by SELinux
description: |+
    SELinux interferes with various PCP services and related programs.

contact: jkurik@redhat.com
component:
  - selinux-policy
  - pcp
require:
  - library(selinux-policy/common)
recommend:
  - audit
  - libselinux
  - libselinux-utils
  - policycoreutils
  - selinux-policy
  - selinux-policy-targeted
  - /usr/sbin/service
  - setools-console
  - glib2
  - pcp
  - pcp-manager
  - pcp-pmda-dm
  - pcp-webapi
environment:
    AVC_ERROR: +no_avc_check
duration: 90m
enabled: true
tag:
  - NoRHEL4
  - TIPpass
  - TIPpass_Security
  - TipWaived7
  - f32friendly
  - failinfedora
  - targeted
  - NoRHIVOS
link:
  - relates: https://bugzilla.redhat.com/show_bug.cgi?id=1028598
  - relates: https://bugzilla.redhat.com/show_bug.cgi?id=1061159
