summary: SELinux interferes with rpmdb program, rpmdb-rebuild service and related
    programs
description: |+
    SELinux interferes with rpmdb program, rpmdb-rebuild service and related programs.

contact: Milos Malik <mmalik@redhat.com>
component:
  - selinux-policy
require:
  - library(selinux-policy/common)
recommend:
  - audit
  - libselinux
  - libselinux-utils
  - policycoreutils
  - selinux-policy
  - selinux-policy-targeted
  - setools-console
  - /usr/sbin/service
  - sssd
environment:
    AVC_ERROR: +no_avc_check
duration: 10m
enabled: true
tag:
  - NoRHEL4
  - NoRHEL5
  - NoRHEL6
  - NoRHEL7
  - NoRHEL8
  - targeted
  - NoRHIVOS
  - avoidImageMode
link:
  - relates: https://bugzilla.redhat.com/show_bug.cgi?id=1461313
  - relates: https://bugzilla.redhat.com/show_bug.cgi?id=1899548
  - relates: https://bugzilla.redhat.com/show_bug.cgi?id=2023163
  - verifies: https://bugzilla.redhat.com/show_bug.cgi?id=2164752
adjust+:
  - enabled: false
    when: distro == rhel-4, rhel-5, rhel-6, rhel-7, rhel-8, centos-stream-8
    continue: false
extra-nitrate: TC#0609732
extra-summary: /CoreOS/selinux-policy/Regression/rpmdb-and-similar
extra-task: /CoreOS/selinux-policy/Regression/rpmdb-and-similar
id: 7444ab1f-9138-4ac1-b92c-825adc7a5436
