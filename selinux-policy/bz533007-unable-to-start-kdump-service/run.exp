#!/usr/bin/expect -f
# ./run.exp password param1 param2 param3
set password [lrange $argv 0 0]
set param1 [lrange $argv 1 1]
set param2 [lrange $argv 2 2]
set param3 [lrange $argv 3 3]
set timeout 15
spawn $param1 $param2 $param3
expect { 
  "yes/no" { send -- "yes\r" }
  eof
}
expect {
  "assword" { send -- "$password\r" }
  eof
}

